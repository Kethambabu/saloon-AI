# Environment Variables - Development Configuration
# Copy this file to .env and update with your local values
# NEVER commit .env to version control

# Application
APP_NAME=SalonAI Workforce API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Database (PostgreSQL)
DATABASE_URL=postgresql://salonai_user:salonai_password@localhost:5432/salonai_db
DATABASE_ECHO=true

# Frontend API URL (used by React app)
VITE_API_URL=http://localhost:8000/api/v1

# Security
SECRET_KEY=your-secret-key-change-in-production-12345

# External APIs
OPENAI_API_KEY=your-openai-key-here
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-key-here

# Features
ENABLE_RAG=true
ENABLE_AGENTS=true

# Database (for docker-compose)
DB_USER=salonai_user
DB_PASSWORD=salonai_password
DB_NAME=salonai_db
