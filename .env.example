# ============================================================================
# SalonAI Workforce API - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="SalonAI Workforce API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# SERVER SETTINGS
# ============================================================================
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secret-key-change-in-production

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Format: "http://localhost:3000,http://localhost:5173" or JSON array
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string for SQLAlchemy
# Format: postgresql+psycopg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://salona:salon_password@localhost:5432/salonai
DATABASE_ECHO=false

# ============================================================================
# LLM & AI CONFIGURATION - GROQ API (FREE)
# ============================================================================

# REQUIRED: Get your free API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# OPTIONAL: Specify custom model (defaults to llama-3.3-70b-versatile)
# Supported models:
#   - llama-3.3-70b-versatile      (PRIMARY - Best all-around balance)
#   - llama-3.1-8b-instant          (FALLBACK - Fast, lightweight)
#   - mixtral-8x7b-32768            (Alternative - Good reasoning)
#   - llama-3.1-70b-versatile       (Stable variant)
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AGENTS=true
ENABLE_RAG=true

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================
# SUPABASE_URL=your-supabase-url
# SUPABASE_KEY=your-supabase-key

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# GROQ API (Free Tier):
# 1. Sign up at https://console.groq.com
# 2. Create an API key in the console
# 3. Copy and paste here as GROQ_API_KEY
# 4. No credit card required!
#
# Database Setup:
# 1. Create PostgreSQL database: createdb salonai
# 2. Set DATABASE_URL to match your connection
# 3. Run migrations: alembic upgrade head
#
# Development vs Production:
# - ENVIRONMENT=development: Enables debug logs and hot reload
# - ENVIRONMENT=production: Disables debug, uses efficient settings
# - DEBUG: Set to false in production
#
# ============================================================================
