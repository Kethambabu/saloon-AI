# Production Environment Variables
# Copy to .env.production and update with production values

# Application
APP_NAME=SalonAI Workforce API
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (PostgreSQL) - Use production database
DATABASE_URL=postgresql://user:password@prod-db-host:5432/salonai_db_prod
DATABASE_ECHO=false

# Frontend API URL
VITE_API_URL=https://api.yourdomain.com/api/v1

# Security - MUST change in production
SECRET_KEY=change-this-to-a-strong-random-key-in-production

# External APIs
OPENAI_API_KEY=your-production-openai-key
SUPABASE_URL=your-production-supabase-url
SUPABASE_KEY=your-production-supabase-key

# Features
ENABLE_RAG=true
ENABLE_AGENTS=true

# CORS Origins - Add your production domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (for docker-compose in production)
DB_USER=secure_user
DB_PASSWORD=very-secure-password-change-this
DB_NAME=salonai_db_prod
